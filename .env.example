# LinksetGo Community environment template.
# Prefer `./scripts/setup-community.sh`; it creates random values in
# `.env.community` with owner-only permissions.

# Docker Compose
# Loopback is the safe default. Change only when a firewall or trusted ingress
# must connect directly to the published port.
RELAY_BIND_ADDRESS=127.0.0.1
RELAY_PORT=3100
RELAY_EDITION=community
POSTGRES_DB=relay
POSTGRES_USER=relay_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://relay_app:replace-with-a-long-random-database-password@postgres:5432/relay

# Server-only secrets. Use separate random values of at least 32 characters.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
EVENT_HASH_SECRET=replace-with-a-different-32-character-random-secret
# Aggregate analytics remain queryable for this many days; the prune job defaults to dry-run.
ANALYTICS_RETENTION_DAYS=90

# Canonical public origins. Community normally sets both values to its one
# application hostname. Managed Cloud sets PUBLIC_LINK_BASE_URL to its
# authenticated app origin and NEXT_PUBLIC_SITE_URL to its marketing origin.
# Use HTTPS for every internet-facing installation.
PUBLIC_LINK_BASE_URL=http://127.0.0.1:3100
# Exact shared Cloud resolver origin for clean /{app}/{link} URLs. It is
# required before CLOUD_SIGNUP_ENABLED can be true and must use a hostname
# separate from the authenticated application and marketing sites.
SHARED_LINK_BASE_URL=
# Used by the local Playwright runner, not for generated link URLs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
E2E_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
# Optional runtime marketing surface for Cloud deployments that separate the
# product website from the authenticated application hostname. It normally
# matches NEXT_PUBLIC_SITE_URL. See docs/operations/LINKSETGO_PRODUCTION.md.
MARKETING_SITE_URL=

# Optional multi-tenant domain routing. Hostnames only: no scheme, path, or wildcard.
# The ingress target must be a DNS name controlled by the LinksetGo operator.
MANAGED_LINK_ROOT_DOMAIN=
MANAGED_INGRESS_CNAME_TARGET=

# Optional trusted adapter for custom-domain DNS/TLS automation. When both
# values are configured, this adapter also overrides Cloud's built-in,
# fixed-record fallback-hostname TXT resolver.
# Configure both values or neither. The URL must use HTTPS and the secret must
# contain at least 32 characters. See docs/operations/DOMAIN_INGRESS.md.
DOMAIN_PROVISIONING_WEBHOOK_URL=
DOMAIN_PROVISIONING_WEBHOOK_SECRET=

# Optional trusted adapter for exact fallback-URL malware and phishing checks.
# The application calls only this fixed webhook; the scanner, not LinksetGo,
# owns any egress required to inspect a tenant URL or its redirect chain.
# Google Web Risk is optional defense in depth and never replaces the scanner.
# When configured, both its reputation lookup and the sandboxed redirect/content
# scan must pass. Restrict the key to Web Risk and the deployment egress IPs.
GOOGLE_WEB_RISK_API_KEY=
FALLBACK_URL_SAFETY_WEBHOOK_URL=
FALLBACK_URL_SAFETY_WEBHOOK_SECRET=
# A safe verdict is reusable for 5 minutes to 7 days. Default: 3600 (1 hour).
FALLBACK_URL_SAFETY_MAX_AGE_SECONDS=3600
# A scheduler must POST the internal sweep route with this bearer secret.
# Use a different random value containing at least 32 characters.
FALLBACK_URL_SAFETY_SWEEP_SECRET=
# Number claimed per sweep, from 1 to 50. Default: 20.
FALLBACK_URL_SAFETY_SWEEP_BATCH_SIZE=20
# DNS TXT ownership is renewed before this bounded lifetime expires.
# Allowed: 3600 to 604800 seconds. Default: 86400 (24 hours).
FALLBACK_ORIGIN_DNS_EVIDENCE_MAX_AGE_SECONDS=86400
# A DNS-provider outage may retain the last proof only until this fixed grace
# after its original expiry. It is never extended by repeated failures.
# Allowed: 0 to 86400 seconds. Default: 21600 (6 hours).
FALLBACK_ORIGIN_DNS_OUTAGE_GRACE_SECONDS=21600
# Number of due ownership records renewed by the same scheduled sweep, 1 to 50.
FALLBACK_ORIGIN_DNS_SWEEP_BATCH_SIZE=20

# Keep false unless a trusted ingress removes the client-supplied header and writes
# exactly one X-Forwarded-Host value.
TRUST_PROXY_HOST_HEADER=false
# This is a separate trust boundary. Cloud signup/recovery requires true and a
# trusted ingress that removes both client-supplied headers and writes exactly
# one canonical client IP value. Community deployments may keep it false.
TRUST_PROXY_CLIENT_IP_HEADER=false

# LinksetGo Cloud operators only. CLOUD_APP_BASE_URL is the exact trusted
# authenticated application origin, without a path. Community ignores these
# values and keeps public signup closed. See docs/operations/CLOUD_SIGNUP.md
# before enabling.
CLOUD_SIGNUP_ENABLED=false
CLOUD_APP_BASE_URL=
# Configure exactly one complete email-delivery mode. The webhook mode remains
# useful for a trusted internal mail service. Direct SMTP requires authenticated
# TLS: use implicit-tls (normally port 465) or mandatory starttls (normally 587).
# Any partial mode, or configuring both modes, disables Cloud signup and recovery.
CLOUD_VERIFICATION_WEBHOOK_URL=
CLOUD_VERIFICATION_WEBHOOK_SECRET=
CLOUD_SMTP_HOST=
CLOUD_SMTP_PORT=
CLOUD_SMTP_SECURITY=
CLOUD_SMTP_USERNAME=
CLOUD_SMTP_PASSWORD=
CLOUD_SMTP_FROM_EMAIL=
# Optional; defaults to "LinksetGo Cloud".
CLOUD_SMTP_FROM_NAME=
# Required by the authenticated scheduled worker that drains the durable,
# encrypted account-email outbox. Generate an independent 32+ character secret.
CLOUD_ACCOUNT_EMAIL_SWEEP_SECRET=
# Optional; defaults to 10 and must be between 1 and 25.
CLOUD_ACCOUNT_EMAIL_SWEEP_BATCH_SIZE=10
# See docs/operations/TEAM_INVITATIONS.md. Configure both or neither.
TEAM_INVITATION_WEBHOOK_URL=
TEAM_INVITATION_WEBHOOK_SECRET=

# Development and test helpers. Never enable production seeding routinely.
RELAY_ALLOWED_DEV_ORIGIN=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
ALLOW_PRODUCTION_SEED=false

# Optional external donation page. Leave empty to keep sponsorship disabled.
SPONSOR_URL=
# Exact public repository/archive containing this deployed version's Corresponding Source.
# Configure before serving an AGPL network deployment publicly.
SOURCE_CODE_URL=

# Public deployment labels baked into the production image.
NEXT_PUBLIC_APP_ENV=Community
NEXT_PUBLIC_DATABASE_LABEL=linksetgo
